### Create a patient through the API gateway; stores its id as patientId for the other requests
# Needs an ADMIN, DOCTOR or NURSE access token: log in via api-requests/gateway/ first, which
# sets {{accessToken}}. The gateway validates it and forwards the caller's identity.
# After the patient is committed, patient-service publishes a patient.created event (IDs only)
# to Kafka, carrying this request's X-Correlation-Id. A broker outage does not fail the request.
POST http://localhost:4004/api/v1/patients
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Daniel",
  "email": "daniel@example.com",
  "address": "234 S New Avn 93240",
  "dateOfBirth": "2000-04-16",
  "registeredDate": "2025-04-12"
}

> {% client.global.set("patientId", response.body.id); %}

###
