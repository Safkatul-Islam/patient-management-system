# Template for the root .env file. Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored (see .gitignore) - never commit real credentials.
# This file is the tracked exception and must stay empty of real values.
#
# Consumed by:
#   - docker-compose.yml       -> initializes the Postgres container
#   - patient-service          -> application.properties imports the root .env
#                                 as a Spring property source; real environment
#                                 variables still take precedence.
#   - auth-service             -> same import mechanism as patient-service.
#
# Note: POSTGRES_USER/POSTGRES_PASSWORD are only applied when the Postgres data
# volume is first initialized. Changing them later requires either an
# `ALTER USER` against the running container or recreating the volume.

POSTGRES_USER=
POSTGRES_PASSWORD=

# --- auth-service database ---
# Role and database (auth_db) are created by docker/postgres/init on a FRESH
# volume only; for an existing volume see the manual steps in that script.
AUTH_DB_USER=
AUTH_DB_PASSWORD=

# --- auth-service access-token signing (RS256) ---
# Key id published in the JWKS and set as the "kid" header, e.g. a date stamp.
AUTH_JWT_KEY_ID=
# Base64 (one line) of a DER-encoded PKCS#8 RSA private key, 2048 bits or more.
# The public key is derived from it. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
AUTH_JWT_PRIVATE_KEY=

# --- auth-service first ADMIN account (optional) ---
# Created at startup only if both are set and no ADMIN exists yet.
# Password: 12-72 characters (and at most 72 bytes as UTF-8).
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
